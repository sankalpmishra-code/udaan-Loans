# Udaan Loans Environment Configuration

# ==============================================================================
# OPTION 1: Google Cloud Service Account (Direct Private Key - Recommended)
# ==============================================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_from_url

# Alternatively, you can paste the entire downloaded service account JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ==============================================================================
# OPTION 2: Google Apps Script Webhook URL (Fallback)
# ==============================================================================
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# ==============================================================================
# Resend Email Integration (Lead Notification & Confirmation Emails)
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Udaan Edu Loans <connect@udaaneduloans.com>"
RESEND_ALERT_EMAIL="sankalp@udaaneduloans.com"
